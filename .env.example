# ============================================================
# ReelFlow — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://reelflow:password@localhost:5432/reelflow

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000
API_SECRET=change-me-to-a-long-random-secret-string

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_EXPIRES_IN=7d

# ─── Instagram / Meta ────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/settings/instagram/callback

# Long-lived access token (optional: set directly for single-account use)
INSTAGRAM_ACCESS_TOKEN=

# ─── Downloader Service ──────────────────────────────────────
# VirtualPirate/insta-reel-api is bundled under services/insta-reel-api
# and runs as the 'downloader' container inside docker compose.
#
# When using docker compose, you do NOT need to set this —
# docker-compose.yml already hardcodes DOWNLOADER_API_URL=http://downloader:8080
# for the worker container via the 'environment:' override.
#
# Only set this if you run the worker OUTSIDE of docker compose (e.g. locally):
DOWNLOADER_API_URL=http://localhost:8080
DOWNLOADER_API_KEY=

# ─── AI Caption Provider ─────────────────────────────────────
# Supported: openai
AI_PROVIDER=openai
AI_API_KEY=

# ─── Storage ─────────────────────────────────────────────────
# Supported: local | cloudinary | azure
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Cloudinary (required for Instagram publishing from local Docker storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Azure Blob Storage (only required when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=reelflow

# ─── Telegram Notifications (optional) ───────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Publishing Safety ───────────────────────────────────────
MAX_DAILY_POSTS=10

# ─── Timezone ────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata

# ─── Video Processing ────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=90
MAX_VIDEO_FILE_SIZE_MB=500
FFMPEG_THREADS=2
VIDEO_ASPECT_MODE=preserve

# ─── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY=3

# ─── Node Environment ────────────────────────────────────────
NODE_ENV=development
