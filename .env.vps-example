# ============================================================
# ReelFlow — VPS Deployment Checklist
# Copy .env and update these values before deploying to VPS
# ============================================================

# ─── CRITICAL: Change these for VPS ─────────────────────────

# Replace with your VPS public IP or domain name
# Example: http://123.45.67.89:4000  OR  https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:4000

# Change these to strong random secrets (never use defaults in production)
API_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS

# ─── Database ────────────────────────────────────────────────
# On VPS: use internal docker network hostname (no change needed)
DATABASE_URL=postgresql://reelflow:STRONG_PASSWORD@postgres:5432/reelflow

# Change the postgres password from default!
# Also update POSTGRES_PASSWORD in docker-compose.yml to match

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ─────────────────────────────────────────────────────
API_PORT=4000

# ─── Auth ────────────────────────────────────────────────────
JWT_EXPIRES_IN=7d

# ─── Instagram / Meta ────────────────────────────────────────
INSTAGRAM_APP_ID=YOUR_APP_ID
INSTAGRAM_APP_SECRET=YOUR_APP_SECRET
# On VPS: change localhost to your domain
INSTAGRAM_REDIRECT_URI=http://YOUR_VPS_IP:3000/settings/instagram/callback
INSTAGRAM_ACCESS_TOKEN=YOUR_LONG_LIVED_TOKEN

# ─── Downloader Service ──────────────────────────────────────
# Do NOT change this — docker compose handles internal networking
DOWNLOADER_API_URL=http://downloader:8080
DOWNLOADER_API_KEY=

# ─── AI Caption Provider ─────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=YOUR_GEMINI_OR_OPENAI_KEY

# ─── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Cloudinary (required for Instagram publishing from local Docker storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ─── Publishing Safety ───────────────────────────────────────
MAX_DAILY_POSTS=10

# ─── Timezone ────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata

# ─── Video Processing ────────────────────────────────────────
MAX_VIDEO_DURATION_SECONDS=90
MAX_VIDEO_FILE_SIZE_MB=500
FFMPEG_THREADS=2
VIDEO_ASPECT_MODE=preserve

# ─── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY=3

# ─── Node Environment ────────────────────────────────────────
NODE_ENV=production
